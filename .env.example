# Copy to .env and adjust. Docker Compose reads .env automatically.

# Host port for http://localhost:<port>.
# The browser keeps Locry's encrypted data per origin (address + port): after changing
# this you start with an empty vault at the new address (passkeys still work, they are
# bound to "localhost" without a port). If you use Google Drive, add the new address to
# "Authorized JavaScript origins" of your OAuth client.
LOCRY_PORT=4200

# Host interface to publish on. 127.0.0.1 keeps Locry reachable from this machine only.
# Do not use 0.0.0.0: passkeys and the service worker need a secure context, which other
# devices only get over HTTPS, and the app is meant to stay local.
LOCRY_BIND_ADDRESS=127.0.0.1
