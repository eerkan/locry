# Copy to .env and adjust. Docker Compose reads .env automatically.

# Host port for http://localhost:<port>.
# The browser keeps Locry's encrypted data per origin (address + port): after changing
# this you start with an empty vault at the new address (passkeys still work, they are
# bound to "localhost" without a port). If you use Google Drive, add the new address to
# "Authorized JavaScript origins" of your OAuth client.
LOCRY_PORT=4200

# Host interface to publish on. 127.0.0.1 keeps Locry reachable from this machine only.
# Do not use 0.0.0.0: passkeys and the service worker need a secure context, which other
# devices only get over HTTPS, and the app is meant to stay local.
LOCRY_BIND_ADDRESS=127.0.0.1

# Built-in Google OAuth Client ID for Drive backups (optional).
# With it, users just click "Connect with Google"; without it, each user has to create
# their own Client ID in Settings. It is a public identifier, not a secret.
# One-time setup by whoever runs this installation:
#   1. console.cloud.google.com: create a project and enable the Google Drive API.
#   2. OAuth consent screen: External; add the app name, support email and a privacy policy URL.
#   3. Credentials -> OAuth client ID -> Web application;
#      Authorized JavaScript origins: http://localhost:4200 (plus any other LOCRY_PORT you use).
#   4. Publish the app ("In production"). Locry only asks for drive.appdata, a non-sensitive
#      scope, so no security review is needed. In "Testing" only listed test users can sign in.
LOCRY_GOOGLE_CLIENT_ID=

# --- Donations (optional) ------------------------------------------------------------------
# Accounts shown under "Support Locry" on the landing page and in Settings. Give account
# names, not URLs: links are always built to the platform itself. Leave all empty to show
# nothing.
#   GitHub Sponsors:  https://github.com/sponsors/<LOCRY_DONATE_GITHUB>
#   Buy Me a Coffee:  https://buymeacoffee.com/<LOCRY_DONATE_BUYMEACOFFEE>
#   Ko-fi:            https://ko-fi.com/<LOCRY_DONATE_KOFI>
#   Open Collective:  https://opencollective.com/<LOCRY_DONATE_OPENCOLLECTIVE>
LOCRY_DONATE_GITHUB=
LOCRY_DONATE_BUYMEACOFFEE=
LOCRY_DONATE_KOFI=
LOCRY_DONATE_OPENCOLLECTIVE=
# Crypto addresses as LABEL:address pairs, separated by commas, e.g.
# LOCRY_DONATE_CRYPTO=BTC:bc1q…,ETH:0x…
# Double-check every address: payments sent to a wrong one cannot be recovered.
LOCRY_DONATE_CRYPTO=

# --- Visitor counts (optional) -------------------------------------------------------------
# Counts visits to the public pages (landing, privacy, terms) with GoatCounter: no cookies,
# no script, no personal data; the app behind the lock screen is never counted. Create a site
# at https://www.goatcounter.com and give its code (the <code> in https://<code>.goatcounter.com).
LOCRY_GOATCOUNTER=

# --- Public domain with HTTPS (optional) -------------------------------------------------
# Serves Locry at https://<LOCRY_DOMAIN> through Caddy, which gets and renews a Let's Encrypt
# certificate automatically. Needs a DNS A/AAAA record pointing to this host and ports
# 80/443 open. Local use at http://localhost keeps working at the same time.
# Each address is a separate vault: passkeys and browser data are tied to the address.
# Move data with a backup and open it with the recovery key on the other address.
# If you use Drive, add https://<LOCRY_DOMAIN> to the OAuth client's JavaScript origins.
#COMPOSE_PROFILES=https
#LOCRY_DOMAIN=locry.example.com

# Public address used in the landing pages' canonical links, sitemap.xml, robots.txt and
# llms.txt (optional). Defaults to https://<LOCRY_DOMAIN>, else the address you open.
#LOCRY_SITE_URL=https://locry.example.com
