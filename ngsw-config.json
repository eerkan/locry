{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.csr.html",
          "/manifest.webmanifest",
          "/theme-init.js",
          "/*.css",
          "/*.js",
          "/icons/**"
        ]
      }
    },
    {
      "name": "ai-runtime",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/ort/**"
        ]
      }
    },
    {
      "name": "landing",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/landing/**",
          "/flags/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/",
    "!/en",
    "!/tr",
    "!/zh",
    "!/es",
    "!/ar",
    "!/pt",
    "!/id",
    "!/fr",
    "!/ja",
    "!/ru",
    "!/de",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ]
}
